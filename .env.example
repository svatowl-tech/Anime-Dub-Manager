# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Local SQLite database path
DATABASE_URL="file:./dev.db"

# Yandex Disk API Keys
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""

# Hugging Face Token for Pyannote model access (WhisperX)
HF_TOKEN=""

# ==============================================================================
# Umbrel OS / Home Server & AI Agent Control Layer
# ==============================================================================
# Set to "true" when running as headless home server (Umbrel / Docker)
ADM_SERVER_MODE="false"

# Persistent storage root on server (projects, episodes, renders, models)
ADM_DATA_DIR="./server_data"

# Prebuilt Python AI environment directory (DeepFilterNet3, Demucs, VoiceFixer, Inworld)
ADM_AI_ENV_DIR="/opt/ai_env"

# HTTP server bind host and port
ADM_HOST="0.0.0.0"
PORT="3000"

# Optional initial curator password / access token for Web UI (if empty, first boot setup screen prompts)
ADM_ACCESS_TOKEN=""

# Optional static Bearer / x-agent-token for AI agents (auto-generated if omitted)
ADM_AGENT_TOKEN=""

# Telegram Bot notifications & interactive curator approvals
ADM_TELEGRAM_BOT_TOKEN=""
ADM_CURATOR_TELEGRAM_CHAT_ID=""

# Target server URL for standalone CLI (server/cli.ts)
ADM_SERVER_URL="http://127.0.0.1:3000"

